# Server & Client Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Direct PostgreSQL URI)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Application Secrets
SESSION_SECRET=dev_session_secret_change_in_production_32chars
QR_TOKEN_SECRET=dev_qr_signing_secret_change_in_production_32chars

# Platform Superadmin (DevAdmin)
DEVADMIN_EMAIL=admin@smartresto.com
DEVADMIN_PASSWORD=change_this_secure_devadmin_password

# Defaults
DEFAULT_COUNTRY_CODE=+91
